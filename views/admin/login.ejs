<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Acceso al Panel de Control | Abelardo Villa Multimarcas</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="icon" type="image/png" href="/images/logo.png">
</head>
<body class="login-split-body">
  <div class="login-split-layout">
    
    <!-- LADO IZQUIERDO: Marca e Identidad sobre ink-950 -->
    <div class="login-brand-panel">
      <div class="login-brand-inner">
        <!-- Logo limpio -->
        <a href="/" class="login-brand-logo-link" title="Ir al sitio web">
          <img src="/images/logo-light.svg" alt="Abelardo Villa Multimarcas" width="220" height="59" class="login-brand-logo">
        </a>

        <div class="login-brand-badge">
          <span class="badge-dot"></span>
          <span>SISTEMA DE GESTIÓN INTERNA</span>
        </div>

        <h1 class="login-brand-heading">
          Pasión y confianza en cada vehículo.
        </h1>

        <p class="login-brand-desc">
          Más de 40 años de trayectoria seleccionando las mejores unidades usadas y 0km en Rincón y Santa Fe. Panel administrativo centralizado para gestión de inventario y clientes.
        </p>

        <div class="login-brand-footer">
          <div class="brand-security-pill">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            <span>Acceso seguro encriptado</span>
          </div>
          <div class="brand-credits">
            <span>Desarrollado por</span>
            <img src="/images/astroweb-logo.png" alt="Astro Web" class="astroweb-badge">
          </div>
        </div>
      </div>
    </div>

    <!-- LADO DERECHO: Formulario Limpio -->
    <div class="login-form-panel">
      <div class="login-form-container">
        
        <div class="login-form-header">
          <div class="login-icon-avatar">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <h2 class="login-form-title">Iniciar Sesión</h2>
          <p class="login-form-subtitle">Ingresá tus credenciales de administrador para continuar</p>
        </div>

        <% if (error) { %>
          <div class="login-alert-error fade-in" role="alert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span><%= error %></span>
          </div>
        <% } %>

        <form method="POST" action="/admin/login" class="login-form" id="adminLoginForm">
          
          <!-- Usuario -->
          <div class="login-field-group">
            <label for="username" class="login-label">Usuario</label>
            <div class="login-input-wrap">
              <svg class="login-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              <input 
                type="text" 
                id="username" 
                name="username" 
                required 
                placeholder="Nombre de usuario" 
                autocomplete="username" 
                class="login-input"
                autofocus
              >
            </div>
          </div>

          <!-- Contraseña con Mostrar/Ocultar -->
          <div class="login-field-group">
            <label for="password" class="login-label">Contraseña</label>
            <div class="login-input-wrap">
              <svg class="login-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <input 
                type="password" 
                id="password" 
                name="password" 
                required 
                placeholder="••••••••••••" 
                autocomplete="current-password" 
                class="login-input login-input-pass"
              >
              <button 
                type="button" 
                class="login-toggle-pass-btn" 
                id="togglePassBtn" 
                title="Mostrar / ocultar contraseña"
                aria-label="Alternar visibilidad de contraseña"
              >
                <svg id="eyeOpenIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
                <svg id="eyeClosedIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;">
                  <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                  <line x1="1" y1="1" x2="23" y2="23"></line>
                </svg>
              </button>
            </div>
          </div>

          <!-- Botón de Ingreso -->
          <button type="submit" class="login-submit-btn" id="loginSubmitBtn">
            <span>Ingresar al Panel</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </form>

        <div class="login-footer-nav">
          <a href="/" class="login-back-link">
            ← Volver a la web pública
          </a>
        </div>

      </div>
    </div>

  </div>

  <script>
    // Mostrar/ocultar contraseña
    const togglePassBtn = document.getElementById('togglePassBtn');
    const passInput = document.getElementById('password');
    const eyeOpen = document.getElementById('eyeOpenIcon');
    const eyeClosed = document.getElementById('eyeClosedIcon');

    if (togglePassBtn && passInput) {
      togglePassBtn.addEventListener('click', () => {
        const isPass = passInput.type === 'password';
        passInput.type = isPass ? 'text' : 'password';
        eyeOpen.style.display = isPass ? 'none' : 'block';
        eyeClosed.style.display = isPass ? 'block' : 'none';
      });
    }
  </script>
</body>
</html>
