<!-- Topbar Admin -->
<header class="admin-topbar">
  <div class="admin-topbar-left">
    <button class="mobile-menu-toggle" id="mobileMenuBtn" type="button" aria-label="Abrir menú de navegación">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
    <div class="admin-topbar-title-wrap">
      <h1 class="admin-topbar-title"><%= typeof title !== 'undefined' ? title : 'Panel de Control' %></h1>
    </div>
  </div>

  <div class="admin-topbar-right">
    <a href="/" target="_blank" class="topbar-btn-site" title="Abrir la web pública en nueva pestaña">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="2" y1="12" x2="22" y2="12"></line>
        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
      </svg>
      <span>Ver sitio</span>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.6;">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
        <polyline points="15 3 21 3 21 9"></polyline>
        <line x1="10" y1="14" x2="21" y2="3"></line>
      </svg>
    </a>

    <div class="admin-user-pill">
      <div class="admin-user-avatar">
        <%= (typeof user !== 'undefined' && user ? user.charAt(0).toUpperCase() : 'A') %>
      </div>
      <div class="admin-user-info">
        <span class="admin-user-name"><%= typeof user !== 'undefined' ? user : 'Admin' %></span>
        <span class="admin-user-role">Administrador</span>
      </div>
    </div>
  </div>
</header>
