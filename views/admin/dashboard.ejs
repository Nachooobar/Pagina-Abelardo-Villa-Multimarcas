<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Abelardo Villa Multimarcas</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="icon" type="image/png" href="/images/logo.png">
</head>
<body>
  <div class="admin-layout">
    <%- include('sidebar') %>

    <main class="admin-main">
      <%- include('topbar') %>

      <div class="admin-content">
        <!-- Dashboard Welcome & Quick Actions -->
        <div class="dashboard-hero-banner">
          <div class="dashboard-hero-content">
            <span class="dashboard-eyebrow">RESUMEN GENERAL</span>
            <h2 class="dashboard-title">Panel de Control Multimarca</h2>
            <p class="dashboard-desc">Monitoreá en tiempo real tu stock de autos publicados, reservas del mes y consultas comerciales.</p>
          </div>
          <div class="dashboard-quick-actions">
            <a href="/admin/autos/nuevo" class="btn btn-primary btn-md">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              <span>Cargar auto</span>
            </a>
            <a href="/" target="_blank" class="btn btn-outline btn-md dashboard-btn-site">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
              <span>Ver sitio</span>
            </a>
          </div>
        </div>

        <!-- 4 Metric Cards Requeridas -->
        <div class="stats-grid">
          <!-- 1. Autos publicados -->
          <div class="stat-card">
            <div class="stat-icon stat-icon-green">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"></path>
                <circle cx="7" cy="17" r="2"></circle>
                <path d="M9 17h6"></path>
                <circle cx="17" cy="17" r="2"></circle>
              </svg>
            </div>
            <div class="stat-details">
              <div class="stat-number"><%= stats.totalPublicados %></div>
              <div class="stat-label">Autos publicados</div>
              <div class="stat-meta">Visibles activamente en la web</div>
            </div>
          </div>

          <!-- 2. Nuevos ingresos del mes -->
          <div class="stat-card">
            <div class="stat-icon stat-icon-blue">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
                <line x1="12" y1="14" x2="12" y2="18"></line>
                <line x1="10" y1="16" x2="14" y2="16"></line>
              </svg>
            </div>
            <div class="stat-details">
              <div class="stat-number"><%= stats.nuevosMes %></div>
              <div class="stat-label">Nuevos ingresos del mes</div>
              <div class="stat-meta">Cargados durante este mes</div>
            </div>
          </div>

          <!-- 3. Reservados -->
          <div class="stat-card">
            <div class="stat-icon stat-icon-amber">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <div class="stat-details">
              <div class="stat-number"><%= stats.totalReservados %></div>
              <div class="stat-label">Reservados / Señados</div>
              <div class="stat-meta">En proceso de cierre comercial</div>
            </div>
          </div>

          <!-- 4. Consultas -->
          <div class="stat-card">
            <div class="stat-icon stat-icon-red">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
            </div>
            <div class="stat-details">
              <div class="stat-number"><%= stats.totalConsultas %></div>
              <div class="stat-label">Consultas</div>
              <div class="stat-meta">Interacciones vía WhatsApp y llamadas</div>
            </div>
          </div>
        </div>

        <!-- Tabla de Últimos Vehículos Cargados -->
        <div class="admin-table-wrap">
          <div class="admin-table-header">
            <div class="table-header-title-wrap">
              <h2>Últimos Vehículos en Inventario</h2>
              <span class="table-header-sub">Visualizá las unidades agregadas recientemente</span>
            </div>
            <div class="table-header-actions">
              <a href="/admin/autos" class="btn btn-outline btn-sm">Ver todos (<%= stats.totalAutos %>)</a>
              <a href="/admin/autos/nuevo" class="btn btn-primary btn-sm">+ Cargar auto</a>
            </div>
          </div>

          <div class="table-responsive">
            <table class="admin-table">
              <thead>
                <tr>
                  <th style="width: 80px;">Foto</th>
                  <th>Vehículo</th>
                  <th>Año</th>
                  <th>Precio</th>
                  <th>Estado</th>
                  <th style="text-align: right;">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% ultimosAutos.forEach(auto => { %>
                  <% 
                    let estadoSlug = (auto.estado || '').toLowerCase();
                    if (!estadoSlug) {
                      estadoSlug = (auto.activo === 0) ? 'vendido' : 'disponible';
                    }
                  %>
                  <tr>
                    <td>
                      <div class="table-thumbnail-4-3">
                        <% 
                          let dImg = auto.imagen;
                          if (!dImg && auto.imagenes) {
                            try {
                              let arr = typeof auto.imagenes === 'string' ? JSON.parse(auto.imagenes) : auto.imagenes;
                              if (Array.isArray(arr) && arr.length > 0) dImg = arr[0];
                            } catch(e) {}
                          }
                          let dSrc = null;
                          if (dImg) {
                            dSrc = (dImg.startsWith('http://') || dImg.startsWith('https://') || dImg.startsWith('/')) ? dImg : '/uploads/autos/' + dImg;
                          }
                        %>
                        <% if (dSrc) { %>
                          <img src="<%= dSrc %>" alt="<%= auto.marca %> <%= auto.modelo %>" loading="lazy">
                        <% } else { %>
                          <div class="table-thumbnail-placeholder">Sin foto</div>
                        <% } %>
                      </div>
                    </td>
                    <td>
                      <div class="table-vehicle-name">
                        <strong><%= auto.marca %> <%= auto.modelo %></strong>
                        <% if (auto.version) { %>
                          <span class="table-vehicle-version"><%= auto.version %></span>
                        <% } %>
                      </div>
                    </td>
                    <td>
                      <span class="table-year-badge"><%= auto.anio %></span>
                    </td>
                    <td>
                      <% if (auto.precio > 0) { %>
                        <strong class="table-price"><%= auto.moneda === 'ARS' ? '$' : 'U$S' %> <%= new Intl.NumberFormat('es-AR').format(auto.precio) %></strong>
                      <% } else { %>
                        <span class="table-price-consultar">Consultar</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (estadoSlug === 'disponible') { %>
                        <span class="badge badge-success">Disponible</span>
                      <% } else if (estadoSlug === 'reservado') { %>
                        <span class="badge badge-warning">Reservado</span>
                      <% } else if (estadoSlug === 'vendido') { %>
                        <span class="badge badge-danger">Vendido</span>
                      <% } else { %>
                        <span class="badge badge-neutral">Proximamente</span>
                      <% } %>
                    </td>
                    <td style="text-align: right;">
                      <div class="table-actions-inline">
                        <a href="/admin/autos/editar/<%= auto.id %>" class="btn btn-outline btn-xs" title="Editar vehiculo">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                          Editar
                        </a>
                        <form method="POST" action="/admin/autos/eliminar/<%= auto.id %>" onsubmit="return confirm('Desea eliminar este vehiculo permanentemente?\n\n<%= auto.marca %> <%= auto.modelo %> (<%= auto.anio %>)\n\nEsta accion borrara tambien sus imagenes y no se puede deshacer.')" style="display:inline;">
                          <button type="submit" class="btn btn-danger-outline btn-xs" title="Eliminar vehiculo">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            Eliminar
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>

                <% if (ultimosAutos.length === 0) { %>
                  <tr>
                    <td colspan="6" class="table-empty-row">
                      <div class="table-empty-state">
                        <div class="empty-state-icon">
                          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--neutral-500);">
                            <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"></path>
                            <circle cx="7" cy="17" r="2"></circle><path d="M9 17h6"></path><circle cx="17" cy="17" r="2"></circle>
                          </svg>
                        </div>
                        <h3>No hay vehículos cargados todavía</h3>
                        <p>Comenzá publicando tu primer vehículo en la web oficial.</p>
                        <a href="/admin/autos/nuevo" class="btn btn-primary btn-sm">+ Cargar el primer vehículo</a>
                      </div>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </main>
  </div>
</body>
</html>
