<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Abelardo Villa Multimarcas</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="icon" type="image/png" href="/images/logo.png">
</head>
<body>
  <div class="admin-layout">
    <%- include('sidebar') %>

    <main class="admin-main">
      <%- include('topbar') %>

      <div class="admin-content">
        <!-- Page Header & Action Bar -->
        <div class="admin-page-header">
          <div>
            <div class="admin-breadcrumb">Gestión / Vehículos</div>
            <h2 class="admin-page-title">Inventario de Vehículos</h2>
            <p class="admin-page-desc">Administrá el catálogo de autos usados y 0km publicados en la web oficial.</p>
          </div>
          <div class="admin-page-actions">
            <a href="/admin/autos/nuevo" class="btn btn-primary btn-md">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              <span>+ Cargar nuevo auto</span>
            </a>
          </div>
        </div>

        <!-- Filter & Search Panel -->
        <div class="admin-filter-card">
          <form class="admin-filter-form" action="/admin/autos" method="GET" id="filterForm">
            <div class="filter-search-wrap">
              <svg class="filter-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input 
                type="text" 
                name="buscar" 
                placeholder="Buscar por marca, modelo, versión..." 
                value="<%= filtros.buscar || '' %>"
                class="filter-search-input"
              >
            </div>

            <div class="filter-selects-group">
              <select name="marca" class="filter-select">
                <option value="">Todas las marcas</option>
                <% marcas.forEach(m => { %>
                  <option value="<%= m.marca %>" <%= filtros.marca === m.marca ? 'selected' : '' %>><%= m.marca %></option>
                <% }) %>
              </select>

              <select name="condicion" class="filter-select">
                <option value="">Condición (Todos)</option>
                <option value="Usado" <%= filtros.condicion === 'Usado' ? 'selected' : '' %>>Usados</option>
                <option value="0km" <%= filtros.condicion === '0km' ? 'selected' : '' %>>0km (Nuevos)</option>
              </select>

              <select name="estado" class="filter-select">
                <option value="">Estado comercial</option>
                <option value="disponible" <%= filtros.estado === 'disponible' ? 'selected' : '' %>>Disponible</option>
                <option value="reservado" <%= filtros.estado === 'reservado' ? 'selected' : '' %>>Reservado</option>
                <option value="vendido" <%= filtros.estado === 'vendido' ? 'selected' : '' %>>Vendido</option>
              </select>

              <button type="submit" class="btn btn-secondary btn-sm">
                Filtrar
              </button>
              <% if (filtros.buscar || filtros.marca || filtros.condicion || filtros.estado) { %>
                <a href="/admin/autos" class="btn btn-ghost btn-sm" title="Restablecer filtros">
                  Limpiar
                </a>
              <% } %>
            </div>
          </form>
        </div>

        <!-- Table Container -->
        <div class="admin-table-wrap">
          <div class="admin-table-header">
            <div class="table-results-count">
              <strong><%= autos.length %></strong> vehículo<%= autos.length !== 1 ? 's' : '' %> encontrado<%= autos.length !== 1 ? 's' : '' %>
            </div>
          </div>

          <div class="table-responsive">
            <table class="admin-table" id="autosTable">
              <thead>
                <tr>
                  <th style="width: 40px; text-align: center;">
                    <input type="checkbox" id="selectAllCheckbox" title="Seleccionar todos los vehículos">
                  </th>
                  <th style="width: 100px;">Foto</th>
                  <th>Vehículo</th>
                  <th>Año</th>
                  <th>Precio</th>
                  <th>Kilometraje</th>
                  <th>Estado</th>
                  <th style="text-align: right; width: 180px;">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% autos.forEach(auto => { %>
                  <% 
                    let estadoSlug = (auto.estado || '').toLowerCase();
                    if (!estadoSlug) {
                      estadoSlug = (auto.activo === 0) ? 'vendido' : 'disponible';
                    }
                  %>
                  <tr data-auto-id="<%= auto.id %>">
                    <!-- Checkbox Selección Masiva -->
                    <td style="text-align: center;">
                      <input type="checkbox" class="auto-row-checkbox" value="<%= auto.id %>" aria-label="Seleccionar auto <%= auto.marca %> <%= auto.modelo %>">
                    </td>

<%
  function getThumbUrl(auto) {
    if (!auto) return null;
    let img = auto.imagen;
    if (!img && auto.imagenes) {
      if (Array.isArray(auto.imagenes) && auto.imagenes.length > 0) img = auto.imagenes[0];
      else if (typeof auto.imagenes === 'string') {
        const t = auto.imagenes.trim();
        if (t.startsWith('[')) {
          try {
            const arr = JSON.parse(t);
            if (arr && arr.length > 0) img = arr[0];
          } catch(e) {}
        } else if (t.startsWith('{')) {
          const arr = t.replace(/[{}]/g, '').split(',').map(s => s.trim().replace(/^"|"$/g, '')).filter(Boolean);
          if (arr.length > 0) img = arr[0];
        } else if (t.length > 0) {
          img = t;
        }
      }
    }
    if (!img) return null;
    if (typeof img === 'string') {
      if (img.startsWith('http://') || img.startsWith('https://') || img.startsWith('/')) return img;
      return '/uploads/autos/' + img;
    }
    return null;
  }
%>
                    <!-- Miniatura 4:3 -->
                    <td>
                      <div class="table-thumbnail-4-3">
                        <% const thumbSrc = getThumbUrl(auto); %>
                        <% if (thumbSrc) { %>
                          <img src="<%= thumbSrc %>" alt="<%= auto.marca %> <%= auto.modelo %>" loading="lazy">
                        <% } else { %>
                          <div class="table-thumbnail-placeholder">Sin foto</div>
                        <% } %>
                        <% if (auto.total_imagenes > 1) { %>
                          <span class="thumbnail-count-badge"><%= auto.total_imagenes %></span>
                        <% } %>
                      </div>
                    </td>

                    <!-- Marca, Modelo, Versión -->
                    <td data-label="Vehículo">
                      <div class="table-vehicle-cell">
                        <span class="table-vehicle-title"><%= auto.marca %> <%= auto.modelo %></span>
                        <% if (auto.version) { %>
                          <span class="table-vehicle-version"><%= auto.version %></span>
                        <% } %>
                        <div class="table-badges-row">
                          <span class="chip-mini <%= auto.condicion === '0km' ? 'chip-0km' : 'chip-usado' %>">
                            <%= auto.condicion === '0km' ? '0km' : 'Usado' %>
                          </span>
                          <% if (auto.destacado) { %>
                            <span class="chip-mini chip-destacado" title="Destacado en la Home">Destacado</span>
                          <% } %>
                        </div>
                      </div>
                    </td>

                    <!-- Año -->
                    <td data-label="Año">
                      <span class="table-year-badge"><%= auto.anio %></span>
                    </td>

                    <!-- Precio -->
                    <td data-label="Precio">
                      <% if (auto.precio > 0) { %>
                        <strong class="table-price">
                          <%= auto.moneda === 'ARS' ? '$' : 'U$S' %> <%= new Intl.NumberFormat('es-AR').format(auto.precio) %>
                        </strong>
                      <% } else { %>
                        <span class="table-price-consultar">Consultar</span>
                      <% } %>
                    </td>

                    <!-- Kilometraje -->
                    <td data-label="Kilómetros">
                      <span class="table-km-cell">
                        <%= auto.kilometraje ? new Intl.NumberFormat('es-AR').format(auto.kilometraje) + ' km' : '0 km' %>
                      </span>
                    </td>

                    <!-- Estado comercial Badge -->
                    <td data-label="Estado">
                      <div class="table-status-dropdown-wrap">
                        <form method="POST" action="/admin/autos/estado/<%= auto.id %>" class="quick-status-form">
                          <select name="estado" class="table-status-select <%= estadoSlug %>" onchange="this.form.submit()" title="Cambiar estado comercial">
                            <option value="disponible" <%= estadoSlug === 'disponible' ? 'selected' : '' %>>Disponible</option>
                            <option value="reservado" <%= estadoSlug === 'reservado' ? 'selected' : '' %>>Reservado</option>
                            <option value="vendido" <%= estadoSlug === 'vendido' ? 'selected' : '' %>>Vendido</option>
                          </select>
                        </form>
                      </div>
                    </td>

                    <!-- Acciones por fila -->
                    <td data-label="Acciones" style="text-align: right;">
                      <div class="table-actions-cluster">
                        <!-- Editar -->
                        <a href="/admin/autos/editar/<%= auto.id %>" class="table-action-btn edit-btn" title="Editar detalles y fotos">
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 20h9"></path>
                            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                          </svg>
                          <span>Editar</span>
                        </a>

                        <!-- Duplicar -->
                        <form method="POST" action="/admin/autos/duplicar/<%= auto.id %>" style="display:inline;">
                          <button type="submit" class="table-action-btn dup-btn" title="Duplicar como borrador">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                            </svg>
                            <span>Duplicar</span>
                          </button>
                        </form>

                        <!-- Eliminar con Confirmación -->
                        <form method="POST" action="/admin/autos/eliminar/<%= auto.id %>" onsubmit="return confirm('⚠️ ¿Estás seguro de eliminar este vehículo permanentemente?\n\n<%= auto.marca %> <%= auto.modelo %> (<%= auto.anio %>)\n\nEsta acción borrará también sus imágenes y no se puede deshacer.')" style="display:inline;">
                          <button type="submit" class="table-action-btn del-btn" title="Eliminar vehículo">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <polyline points="3 6 5 6 21 6"></polyline>
                              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                            </svg>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>

                <% if (autos.length === 0) { %>
                  <tr>
                    <td colspan="8" class="table-empty-row">
                      <div class="table-empty-state">
                        <div class="empty-state-icon">
                          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--neutral-500);">
                            <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                          </svg>
                        </div>
                        <h3>No encontramos vehículos</h3>
                        <p>Probá modificando los filtros de búsqueda o cargá un nuevo auto en el inventario.</p>
                        <div style="display:flex;gap:0.75rem;justify-content:center;margin-top:0.75rem;">
                          <a href="/admin/autos" class="btn btn-outline btn-sm">Limpiar filtros</a>
                          <a href="/admin/autos/nuevo" class="btn btn-primary btn-sm">+ Cargar auto</a>
                        </div>
                      </div>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </main>
  </div>

  <!-- BARRA FLOTANTE DE ACCIONES MASIVAS -->
  <div class="floating-mass-bar" id="massActionBar" style="display:none;">
    <div class="mass-bar-container">
      <div class="mass-bar-info">
        <span class="mass-selected-badge" id="massSelectedCount">0</span>
        <span class="mass-selected-text">vehículos seleccionados</span>
      </div>
      <div class="mass-bar-actions">
        <!-- Formulario para POST masivo -->
        <form method="POST" action="/admin/autos/masivo" id="massActionForm" style="display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap;">
          <input type="hidden" name="ids" id="massIdsInput">
          <input type="hidden" name="accion" id="massAccionInput">

          <button type="button" class="btn-mass mass-btn-available" onclick="submitMassAction('disponible')">
            Disponible
          </button>
          <button type="button" class="btn-mass mass-btn-reserve" onclick="submitMassAction('reservado')">
            Reservar
          </button>
          <button type="button" class="btn-mass mass-btn-sold" onclick="submitMassAction('vendido')">
            Vendido
          </button>
          <button type="button" class="btn-mass mass-btn-delete" onclick="submitMassAction('eliminar')">
            Eliminar
          </button>
        </form>
        <button type="button" class="btn-mass-cancel" id="cancelMassBtn" title="Cancelar seleccion">X</button>
      </div>
    </div>
  </div>

  <script>
    // ── GESTIÓN DE ACCIONES MASIVAS Y CHECKBOXES ──
    (function() {
      var selectAll = document.getElementById('selectAllCheckbox');
      var rowCheckboxes = document.querySelectorAll('.auto-row-checkbox');
      var massBar = document.getElementById('massActionBar');
      var massCount = document.getElementById('massSelectedCount');
      var massIdsInput = document.getElementById('massIdsInput');
      var massAccionInput = document.getElementById('massAccionInput');
      var massForm = document.getElementById('massActionForm');
      var cancelBtn = document.getElementById('cancelMassBtn');

      function updateMassBar() {
        var checked = Array.from(rowCheckboxes).filter(function(cb) { return cb.checked; });
        var count = checked.length;

        if (count > 0) {
          massCount.textContent = count;
          massBar.style.display = 'block';
          var selectedIds = checked.map(function(cb) { return cb.value; });
          massIdsInput.value = selectedIds.join(',');
        } else {
          massBar.style.display = 'none';
          massIdsInput.value = '';
        }

        if (selectAll) {
          selectAll.checked = (count === rowCheckboxes.length && rowCheckboxes.length > 0);
          selectAll.indeterminate = (count > 0 && count < rowCheckboxes.length);
        }
      }

      if (selectAll) {
        selectAll.addEventListener('change', function() {
          var isChecked = this.checked;
          rowCheckboxes.forEach(function(cb) {
            cb.checked = isChecked;
          });
          updateMassBar();
        });
      }

      rowCheckboxes.forEach(function(cb) {
        cb.addEventListener('change', updateMassBar);
      });

      if (cancelBtn) {
        cancelBtn.addEventListener('click', function() {
          rowCheckboxes.forEach(function(cb) { cb.checked = false; });
          if (selectAll) selectAll.checked = false;
          updateMassBar();
        });
      }

      window.submitMassAction = function(accion) {
        var checked = Array.from(rowCheckboxes).filter(function(cb) { return cb.checked; });
        if (checked.length === 0) return;

        if (accion === 'eliminar') {
          var confirmMsg = '⚠️ ¿Estás seguro de eliminar ' + checked.length + ' vehículo(s) seleccionado(s)? Esta acción borrará sus imágenes y no se puede deshacer.';
          if (!confirm(confirmMsg)) return;
        }

        massAccionInput.value = accion;
        massForm.submit();
      };
    })();
  </script>
</body>
</html>
