<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="<%= brand.seo.themeColor || '#0E1116' %>">
  <meta name="msapplication-navbutton-color" content="<%= brand.seo.themeColor || '#0E1116' %>">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="description"
    content="<%= (typeof seoDescription !== 'undefined' && seoDescription) ? seoDescription : (brand.seo.defaultDescription || brand.description) %>">
  <meta name="keywords" content="<%= brand.seo.keywords %>">

  <!-- Canonical & Open Graph -->
  <link rel="canonical"
    href="https://abelardovillautos.com.ar<%= typeof currentPath !== 'undefined' ? currentPath : '' %>">
  <meta property="og:title"
    content="<%= (typeof seoTitle !== 'undefined' && seoTitle) ? seoTitle : ((typeof title !== 'undefined' && title) ? title : brand.seo.baseTitle) %>">
  <meta property="og:description"
    content="<%= (typeof seoDescription !== 'undefined' && seoDescription) ? seoDescription : (brand.seo.defaultDescription || brand.description) %>">
  <meta property="og:image"
    content="<%= brand.seo.ogImage || 'https://abelardovillautos.com.ar/images/logo-light.svg' %>">
  <meta property="og:url"
    content="https://abelardovillautos.com.ar<%= typeof currentPath !== 'undefined' ? currentPath : '' %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Abelardo Villa Multimarcas">
  <meta property="og:locale" content="es_AR">
  <meta name="twitter:card" content="summary_large_image">

  <title>
    <%= (typeof seoTitle !=='undefined' && seoTitle) ? seoTitle : ((typeof title !=='undefined' && title) ? title :
      brand.seo.baseTitle) %>
  </title>

  <!-- Schema.org AutoDealer (LocalBusiness) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "AutoDealer",
    "name": "Abelardo Villa Multimarcas",
    "image": "https://abelardovillautos.com.ar/images/logo-light.svg",
    "@id": "https://abelardovillautos.com.ar",
    "url": "https://abelardovillautos.com.ar",
    "telephone": "+54 9 342 548-8000",
    "priceRange": "$$",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Ruta 1 KM 5.5",
      "addressLocality": "San José del Rincón",
      "addressRegion": "Santa Fe",
      "postalCode": "S3001",
      "addressCountry": "AR"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": -31.6107626,
      "longitude": -60.5826109
    },
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "10:00",
        "closes": "19:00"
      }
    ],
    "sameAs": [
      "https://www.instagram.com/abelardo_raul_villa"
    ]
  }
  </script>

  <!-- Fonts: Sora (Headings) & Inter (Body) with font-display: swap -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@500;600;700;800&display=swap"
    rel="stylesheet">

  <!-- Design System & Styles (v3.0 - Fresh Layout & Cache-Busting) -->
  <link rel="stylesheet" href="/css/tokens.css?v=3.0">
  <link rel="stylesheet" href="/css/components.css?v=3.0">
  <link rel="stylesheet" href="/css/style.css?v=3.0">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/images/logo-light.svg">
  <link rel="alternate icon" type="image/png" href="/images/logo.png">
</head>

<body>

  <!-- Skip Link for Accessibility -->
  <a href="#mainContent" class="skip-to-content">Saltar al contenido principal</a>

  <!-- ==================== HEADER GLOBAL ==================== -->
  <header class="site-header" id="siteHeader">

    <!-- 1. Barra Superior Fina y Oscura -->
    <div class="topbar" id="topbar">
      <div class="container topbar__container">
        <div class="topbar__left">
          <a href="tel:<%= brand.contact.phoneRaw || brand.contact.phone %>" class="topbar__item topbar__link">
            <svg class="topbar__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z">
              </path>
            </svg>
            <span>
              <%= brand.contact.phone %>
            </span>
          </a>
          <span class="topbar__divider" aria-hidden="true">•</span>
          <div class="topbar__item">
            <svg class="topbar__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>
              <%= brand.contact.schedule ? brand.contact.schedule.compact : 'Lun a Vie 10:00 - 19:00 hs' %>
            </span>
          </div>
        </div>

        <div class="topbar__right">
          <a href="<%= brand.social.instagram %>" target="_blank" rel="noopener noreferrer"
            class="topbar__item topbar__link" aria-label="Instagram <%= brand.social.instagramHandle %>">
            <svg class="topbar__icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
            </svg>
            <span>
              <%= brand.social.instagramHandle || '@abelardo_raul_villa' %>
            </span>
          </a>
          <span class="topbar__divider" aria-hidden="true">•</span>
          <a href="<%= brand.contact.maps.url %>" target="_blank" rel="noopener noreferrer"
            class="topbar__item topbar__link">
            <svg class="topbar__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>Rincón, Santa Fe</span>
          </a>
        </div>
      </div>
    </div>

    <!-- 2. Header Principal Sticky con Logo Limpio y Navegación Única -->
    <nav class="navbar" id="navbar">
      <div class="container navbar__container">
        <!-- Logo versión SVG limpia -->
        <a href="/" class="navbar__brand" aria-label="Ir a Inicio - <%= brand.name %>">
          <img src="/images/logo-light.svg" alt="<%= brand.name %>" width="180" height="48" class="logo-clean">
        </a>

        <!-- Menú de Navegación Unificado (Desktop) -->
        <div class="navbar__nav" id="navbarDesktopNav">
          <a href="/catalogo"
            class="nav-link <%= typeof currentPath !== 'undefined' && currentPath === '/catalogo' && (!filtros || !filtros.condicion) ? 'active' : '' %>">Vehículos</a>
          <a href="/catalogo?condicion=0km"
            class="nav-link <%= typeof currentPath !== 'undefined' && currentPath === '/catalogo' && typeof filtros !== 'undefined' && filtros && filtros.condicion === '0km' ? 'active' : '' %>">0km</a>
          <a href="/vender-permutar"
            class="nav-link <%= typeof currentPath !== 'undefined' && currentPath === '/vender-permutar' ? 'active' : '' %>">Vender
            / Permutar</a>
          <a href="/financiacion"
            class="nav-link <%= typeof currentPath !== 'undefined' && currentPath === '/financiacion' ? 'active' : '' %>">Financiación</a>
          <a href="/nosotros"
            class="nav-link <%= typeof currentPath !== 'undefined' && currentPath === '/nosotros' ? 'active' : '' %>">Nosotros</a>
          <a href="/contacto"
            class="nav-link <%= typeof currentPath !== 'undefined' && currentPath === '/contacto' ? 'active' : '' %>">Contacto</a>
        </div>

        <!-- Botón CTA Rojo "Consultar por WhatsApp" (Desktop) -->
        <div class="navbar__actions">
          <a href="<%= getWhatsAppLink() %>" target="_blank" rel="noopener noreferrer"
            class="ds-btn ds-btn--primary ds-btn--sm header-cta-btn">
            <svg class="ds-btn__icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.67-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421-7.403h-.004a9.87 9.87 0 00-5.031 1.378l-.361.214-3.741-.982.998 3.645-.235.364a9.964 9.964 0 001.523 5.074c.711 1.103 1.632 2.053 2.692 2.792 1.393.953 3.042 1.464 4.782 1.464 1.487 0 2.926-.358 4.206-1.031l.364-.214 3.758.981-.997-3.648.236-.363a9.968 9.968 0 00-1.522-5.037c-.71-1.097-1.628-2.043-2.687-2.787-.695-.477-1.477-.885-2.313-1.107-.338-.089-.681-.135-1.025-.127z" />
            </svg>
            <span>Consultar por WhatsApp</span>
          </a>

          <!-- Botón Hamburguesa Móvil -->
          <button class="mobile-hamburger" id="mobileHamburger" aria-label="Abrir menú de navegación"
            aria-expanded="false" aria-controls="mobileDrawer">
            <span class="hamburger-bar"></span>
            <span class="hamburger-bar"></span>
            <span class="hamburger-bar"></span>
          </button>
        </div>
      </div>
    </nav>
  </header>

  <!-- ==================== DRAWER MÓVIL A PANTALLA COMPLETA ==================== -->
  <div class="mobile-drawer" id="mobileDrawer" aria-hidden="true" role="dialog" aria-label="Menú principal"
    style="display: none;">
    <div class="mobile-drawer__backdrop" id="mobileDrawerBackdrop"></div>
    <div class="mobile-drawer__content">
      <div class="mobile-drawer__header">
        <a href="/" class="mobile-drawer__brand" id="drawerBrandLink">
          <img src="/images/logo-light.svg" alt="<%= brand.name %>" width="160" height="42" class="logo-clean">
        </a>
        <button class="mobile-drawer__close" id="mobileDrawerClose" aria-label="Cerrar menú">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <nav class="mobile-drawer__nav">
        <a href="/"
          class="drawer-link <%= typeof currentPath !== 'undefined' && currentPath === '/' ? 'active' : '' %>">
          <span>Inicio</span>
          <span class="drawer-arrow">→</span>
        </a>
        <a href="/catalogo"
          class="drawer-link <%= typeof currentPath !== 'undefined' && currentPath === '/catalogo' && (!filtros || !filtros.condicion) ? 'active' : '' %>">
          <span>Vehículos</span>
          <span class="drawer-arrow">→</span>
        </a>
        <a href="/catalogo?condicion=0km"
          class="drawer-link <%= typeof currentPath !== 'undefined' && currentPath === '/catalogo' && typeof filtros !== 'undefined' && filtros && filtros.condicion === '0km' ? 'active' : '' %>">
          <span>0km</span>
          <span class="drawer-arrow">→</span>
        </a>
        <a href="/vender-permutar"
          class="drawer-link <%= typeof currentPath !== 'undefined' && currentPath === '/vender-permutar' ? 'active' : '' %>">
          <span>Vender / Permutar</span>
          <span class="drawer-arrow">→</span>
        </a>
        <a href="/financiacion"
          class="drawer-link <%= typeof currentPath !== 'undefined' && currentPath === '/financiacion' ? 'active' : '' %>">
          <span>Financiación</span>
          <span class="drawer-arrow">→</span>
        </a>
        <a href="/nosotros"
          class="drawer-link <%= typeof currentPath !== 'undefined' && currentPath === '/nosotros' ? 'active' : '' %>">
          <span>Nosotros</span>
          <span class="drawer-arrow">→</span>
        </a>
        <a href="/contacto"
          class="drawer-link <%= typeof currentPath !== 'undefined' && currentPath === '/contacto' ? 'active' : '' %>">
          <span>Contacto</span>
          <span class="drawer-arrow">→</span>
        </a>
      </nav>

      <!-- CTA Destacado en Móvil -->
      <div class="mobile-drawer__cta">
        <a href="<%= getWhatsAppLink() %>" target="_blank" rel="noopener noreferrer"
          class="ds-btn ds-btn--primary ds-btn--lg ds-btn--block">
          <svg class="ds-btn__icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.67-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421-7.403h-.004a9.87 9.87 0 00-5.031 1.378l-.361.214-3.741-.982.998 3.645-.235.364a9.964 9.964 0 001.523 5.074c.711 1.103 1.632 2.053 2.692 2.792 1.393.953 3.042 1.464 4.782 1.464 1.487 0 2.926-.358 4.206-1.031l.364-.214 3.758.981-.997-3.648.236-.363a9.968 9.968 0 00-1.522-5.037c-.71-1.097-1.628-2.043-2.687-2.787-.695-.477-1.477-.885-2.313-1.107-.338-.089-.681-.135-1.025-.127z" />
          </svg>
          <span>Consultar por WhatsApp</span>
        </a>
      </div>

      <!-- Información de Contacto en Drawer -->
      <div class="mobile-drawer__footer">
        <div class="drawer-contact-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path
              d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z">
            </path>
          </svg>
          <a href="tel:<%= brand.contact.phoneRaw || brand.contact.phone %>">
            <%= brand.contact.phone %>
          </a>
        </div>
        <div class="drawer-contact-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <span>
            <%= brand.contact.schedule ? brand.contact.schedule.compact : 'Lun a Vie 10:00 - 19:00 hs' %>
          </span>
        </div>
        <div class="drawer-contact-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span>
            <%= brand.contact.maps.address %>
          </span>
        </div>
        <div class="drawer-social">
          <a href="<%= brand.social.instagram %>" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
            </svg>
            <span>Instagram</span>
          </a>
          <a href="<%= brand.social.facebook %>" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
            </svg>
            <span>Facebook</span>
          </a>
        </div>
      </div>
    </div>
  </div>