<%- include('partials/header') %>

  <main id="mainContent">
    <!-- ==================== 1. HERO CON BUSCADOR PROTAGONISTA ==================== -->
    <section class="hero-v2" id="hero">
      <div class="container hero-content-v2">
        <!-- Eyebrow -->
        <div class="fade-up">
          <span class="hero-eyebrow">
            MULTIMARCA · +40 AÑOS
          </span>
        </div>

        <!-- Título Grande (Sora) -->
        <h1 class="hero-title-v2 fade-up">
          Tu próximo auto con la <span style="color: var(--color-primary);">mejor financiación</span>
        </h1>

        <p class="hero-subtitle-v2 fade-up">
          Más de 40 años seleccionando los mejores vehículos usados y 0km de Santa Fe con garantía, transparencia y
          financiación a tu medida.
        </p>

        <!-- Buscador Protagonista (Inspiración Castellaro) -->
        <div class="hero-search-box fade-up">
          <!-- Tabs Usados / 0km / Todos -->
          <div class="search-tabs" role="tablist" aria-label="Condición del vehículo">
            <button type="button" class="search-tab-btn active" data-condicion="" role="tab" aria-selected="true">
              Todos los vehículos
            </button>
            <button type="button" class="search-tab-btn" data-condicion="Usado" role="tab" aria-selected="false">
              Usados seleccionados
            </button>
            <button type="button" class="search-tab-btn" data-condicion="0km" role="tab" aria-selected="false">
              0km
            </button>
          </div>

          <!-- Formulario de Búsqueda -->
          <form action="/catalogo" method="GET" id="heroSearchForm">
            <input type="hidden" name="condicion" id="searchCondicion" value="">

            <div class="hero-filters-grid">
              <!-- 1. Marca -->
              <div class="hero-filter-field">
                <label for="heroMarca">Marca</label>
                <select name="marca" id="heroMarca">
                  <option value="">Todas las marcas</option>
                  <% if (Array.isArray(marcas)) { %>
                    <% marcas.forEach(m=> { %>
                      <option value="<%= m.marca %>">
                        <%= m.marca %>
                      </option>
                      <% }) %>
                        <% } %>
                </select>
              </div>

              <!-- 2. Modelo (se habilita dinámicamente según la marca) -->
              <div class="hero-filter-field">
                <label for="heroModelo">Modelo</label>
                <select name="modelo" id="heroModelo" disabled>
                  <option value="">Elegí una marca primero</option>
                </select>
              </div>

              <!-- 3. Tipo -->
              <div class="hero-filter-field">
                <label for="heroTipo">Tipo</label>
                <select name="tipo" id="heroTipo">
                  <option value="">Todos los tipos</option>
                  <option value="SUV">SUV</option>
                  <option value="Pick-up">Pick-up</option>
                  <option value="Sedan">Sedán</option>
                  <option value="Hatchback">Hatchback</option>
                  <option value="Utilitario">Utilitario</option>
                </select>
              </div>

              <!-- 4. Botón Rojo Buscar -->
              <button type="submit" class="ds-btn ds-btn--primary hero-search-btn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                  stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <span>Buscar</span>
              </button>
            </div>
          </form>
        </div>

        <!-- CTAs Secundarios -->
        <div class="hero-ctas-secondary fade-up">
          <a href="/catalogo" class="hero-secondary-link">
            Ver catálogo completo (<%= totalAutos %> vehículos disponibles) →
          </a>
          <span style="color: var(--neutral-600);">•</span>
          <a href="<%= getWhatsAppLink() %>" target="_blank" rel="noopener noreferrer"
            class="ds-btn ds-btn--outline ds-btn--sm" style="border-radius: var(--radius-full);">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.67-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421-7.403h-.004a9.87 9.87 0 00-5.031 1.378l-.361.214-3.741-.982.998 3.645-.235.364a9.964 9.964 0 001.523 5.074c.711 1.103 1.632 2.053 2.692 2.792 1.393.953 3.042 1.464 4.782 1.464 1.487 0 2.926-.358 4.206-1.031l.364-.214 3.758.981-.997-3.648.236-.363a9.968 9.968 0 00-1.522-5.037c-.71-1.097-1.628-2.043-2.687-2.787-.695-.477-1.477-.885-2.313-1.107-.338-.089-.681-.135-1.025-.127z" />
            </svg>
            <span>Consultar por WhatsApp</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ==================== 2. FRANJA DE CONFIANZA ==================== -->
    <section class="trust-bar" aria-label="Beneficios y trayectoria">
      <div class="container">
        <div class="trust-grid">
          <!-- 1. Trayectoria -->
          <div class="trust-item fade-up">
            <div class="trust-icon-box">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <polygon
                  points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2">
                </polygon>
              </svg>
            </div>
            <div>
              <div class="trust-title">+40 Años de Trayectoria</div>
              <p class="trust-desc">Concesionaria familiar con respaldo histórico en Santa Fe.</p>
            </div>
          </div>

          <!-- 2. Financiación -->
          <div class="trust-item fade-up">
            <div class="trust-icon-box">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                <line x1="1" y1="10" x2="23" y2="10"></line>
              </svg>
            </div>
            <div>
              <div class="trust-title">Financiación a Medida</div>
              <p class="trust-desc">Créditos prendarios en cuotas fijas en pesos.</p>
            </div>
          </div>

          <!-- 3. Toma de Usados -->
          <div class="trust-item fade-up">
            <div class="trust-icon-box">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <polyline points="23 4 23 10 17 10"></polyline>
                <polyline points="1 20 1 14 7 14"></polyline>
                <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
              </svg>
            </div>
            <div>
              <div class="trust-title">Toma de Usados y Permutas</div>
              <p class="trust-desc">Tasación en el acto con cotización real de mercado.</p>
            </div>
          </div>

          <!-- 4. Gestoría / Transferencia -->
          <div class="trust-item fade-up">
            <div class="trust-icon-box">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
            </div>
            <div>
              <div class="trust-title">Gestoría y Transferencia</div>
              <p class="trust-desc">Documentación 100% garantizada y trámites rápidos.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== 3. VEHÍCULOS DESTACADOS ==================== -->
    <% if (destacados && destacados.length> 0) { %>
      <section class="home-section section-surface" id="vehiculosDestacados"
        style="background-color: #0E1116; color: #FFFFFF;">
        <div class="container">
          <div class="section-header-wrap fade-up">
            <span class="section-tag-v2" style="color: var(--color-primary, #E11D2A);">★ Selección Premium</span>
            <h2 class="section-title-v2" style="color: #FFFFFF; text-shadow: 0 2px 10px rgba(0,0,0,0.5);">Vehículos
              Destacados</h2>
            <p class="section-subtitle-v2" style="color: #C2C9D6;">
              Nuestras unidades más destacadas, seleccionadas por su calidad, estado y relación precio-valor.
            </p>
          </div>

          <div class="vehicles-grid fade-up">
            <% destacados.forEach(auto=> { %>
              <%- include('partials/vehicle-card', { auto, generateSlug, badge: 'Destacado' }) %>
                <% }) %>
          </div>

          <div style="text-align: center; margin-top: 3.5rem;" class="fade-up">
            <a href="/catalogo" class="ds-btn ds-btn--outline ds-btn--lg" style="border-radius: var(--radius-full);">
              Ver todos los vehículos en stock →
            </a>
          </div>
        </div>
      </section>
      <% } %>

        <!-- ==================== 4. NUEVOS INGRESOS (CarCards 4:3) ==================== -->
        <% // Filtrar nuevos ingresos para no repetir vehículos destacados const destacadoIds=(destacados || []).map(d=>
          d.id);
          const nuevosIngresosUnicos = (nuevosIngresos || []).filter(a => !destacadoIds.includes(a.id));
          %>
          <% if (nuevosIngresosUnicos && nuevosIngresosUnicos.length> 0) { %>
            <section class="home-section section-surface" id="nuevosIngresos"
              style="background-color: #0E1116; color: #FFFFFF;">
              <div class="container">
                <div class="section-header-wrap fade-up">
                  <span class="section-tag-v2" style="color: var(--color-primary, #E11D2A);">★ Recién Llegados</span>
                  <h2 class="section-title-v2" style="color: #FFFFFF; text-shadow: 0 2px 10px rgba(0,0,0,0.5);">Nuevos
                    Ingresos</h2>
                  <p class="section-subtitle-v2" style="color: #C2C9D6;">
                    Los vehículos más recientes incorporados a nuestro stock cuidadosamente seleccionado.
                  </p>
                </div>

                <div class="vehicles-grid fade-up">
                  <% nuevosIngresosUnicos.forEach(auto=> { %>
                    <%- include('partials/vehicle-card', { auto, generateSlug, badge: 'Nuevo ingreso' }) %>
                      <% }) %>
                </div>

                <div style="text-align: center; margin-top: 3.5rem;" class="fade-up">
                  <a href="/catalogo" class="ds-btn ds-btn--outline ds-btn--lg"
                    style="border-radius: var(--radius-full);">
                    Ver todos los vehículos en stock →
                  </a>
                </div>
              </div>
            </section>
            <% } else if (!destacados || destacados.length===0) { %>
              <section class="home-section section-surface" id="nuevosIngresos"
                style="background-color: #0E1116; color: #FFFFFF;">
                <div class="container">
                  <div class="section-header-wrap fade-up">
                    <span class="section-tag-v2" style="color: var(--color-primary, #E11D2A);">★ Recién Llegados</span>
                    <h2 class="section-title-v2" style="color: #FFFFFF; text-shadow: 0 2px 10px rgba(0,0,0,0.5);">Nuevos
                      Ingresos</h2>
                    <p class="section-subtitle-v2" style="color: #C2C9D6;">
                      Los vehículos más recientes incorporados a nuestro stock cuidadosamente seleccionado.
                    </p>
                  </div>
                  <div class="ds-card text-center fade-up" style="padding: 3rem; max-width: 600px; margin: 0 auto;">
                    <span style="font-size: 3rem; display: block; margin-bottom: 1rem;">🚗</span>
                    <h3
                      style="font-family: var(--font-heading); font-size: var(--text-xl); color: #fff; margin-bottom: 0.5rem;">
                      Stock en Preparación</h3>
                    <p
                      style="color: var(--neutral-400); font-size: var(--text-sm); line-height: 1.6; margin-bottom: 1.5rem;">
                      Estamos incorporando nuevas unidades exclusivas a nuestro salón. Escribinos para conocer los
                      ingresos antes de su publicación.
                    </p>
                    <a href="<%= getWhatsAppLink() %>" target="_blank" rel="noopener noreferrer"
                      class="ds-btn ds-btn--primary">
                      Consultar próximos ingresos por WhatsApp
                    </a>
                  </div>
                </div>
              </section>
              <% } %>

                <!-- ==================== 4. EXPLORAR POR TIPO ==================== -->
                <section class="home-section section-dark" id="explorarPorTipo">
                  <div class="container">
                    <div class="section-header-wrap fade-up">
                      <span class="section-tag-v2">Categorías</span>
                      <h2 class="section-title-v2">Explorá por Tipo de Vehículo</h2>
                      <p class="section-subtitle-v2">
                        Encontrá el formato ideal según tus necesidades de manejo, familia o trabajo.
                      </p>
                    </div>

                    <div class="type-grid fade-up">
                      <!-- SUV -->
                      <a href="/catalogo?tipo=SUV" class="type-card" aria-label="Ver vehículos tipo SUV">
                        <div class="type-card__icon">
                          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path
                              d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9C2.1 11.1 2 11.5 2 12v4c0 .6.4 1 1 1h2">
                            </path>
                            <circle cx="7" cy="17" r="2"></circle>
                            <path d="M9 17h6"></path>
                            <circle cx="17" cy="17" r="2"></circle>
                          </svg>
                        </div>
                        <div class="type-card__name">SUV</div>
                        <span class="type-card__count">Espacio y confort</span>
                      </a>

                      <!-- Pick-up -->
                      <a href="/catalogo?tipo=Pick-up" class="type-card" aria-label="Ver vehículos tipo Pick-up">
                        <div class="type-card__icon">
                          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 17h4c.6 0 1-.4 1-1v-3h3v4c0 .6-.4 1-1 1h-1"></path>
                            <path d="M2 12v4c0 .6.4 1 1 1h2"></path>
                            <circle cx="7" cy="17" r="2"></circle>
                            <path d="M9 17h6"></path>
                            <circle cx="17" cy="17" r="2"></circle>
                            <path d="M14 9V6a1 1 0 0 0-1-1H6a1 1 0 0 0-1 1v4l-2 2"></path>
                          </svg>
                        </div>
                        <div class="type-card__name">Pick-up</div>
                        <span class="type-card__count">Potencia y carga</span>
                      </a>

                      <!-- Sedán -->
                      <a href="/catalogo?tipo=Sedan" class="type-card" aria-label="Ver vehículos tipo Sedán">
                        <div class="type-card__icon">
                          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path
                              d="M19 17h2c.6 0 1-.4 1-1v-2c0-.6-.3-1.2-.8-1.5L18 11s-1.5-3-3-3H9L6.5 11l-3 1.5c-.5.3-.8.9-.8 1.5v2c0 .6.4 1 1 1h2">
                            </path>
                            <circle cx="7" cy="17" r="2"></circle>
                            <path d="M9 17h6"></path>
                            <circle cx="17" cy="17" r="2"></circle>
                          </svg>
                        </div>
                        <div class="type-card__name">Sedán</div>
                        <span class="type-card__count">Elegancia y baúl</span>
                      </a>

                      <!-- Hatchback -->
                      <a href="/catalogo?tipo=Hatchback" class="type-card" aria-label="Ver vehículos tipo Hatchback">
                        <div class="type-card__icon">
                          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path
                              d="M18 17h2c.6 0 1-.4 1-1v-3c0-.6-.3-1.1-.7-1.4L17 9.5c-.4-.4-.9-.5-1.4-.5H9L6 11.5l-3 1c-.6.2-1 .8-1 1.5v2c0 .6.4 1 1 1h2">
                            </path>
                            <circle cx="7" cy="17" r="2"></circle>
                            <path d="M9 17h6"></path>
                            <circle cx="17" cy="17" r="2"></circle>
                          </svg>
                        </div>
                        <div class="type-card__name">Hatchback</div>
                        <span class="type-card__count">Ágil y urbano</span>
                      </a>

                      <!-- Utilitario -->
                      <a href="/catalogo?tipo=Utilitario" class="type-card" aria-label="Ver vehículos tipo Utilitario">
                        <div class="type-card__icon">
                          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="1" y="5" width="15" height="12" rx="2"></rect>
                            <path d="M16 8h4l3 3v5a1 1 0 0 1-1 1h-2"></path>
                            <circle cx="6" cy="17" r="2"></circle>
                            <circle cx="18" cy="17" r="2"></circle>
                          </svg>
                        </div>
                        <div class="type-card__name">Utilitario</div>
                        <span class="type-card__count">Rendimiento comercial</span>
                      </a>
                    </div>
                  </div>
                </section>

                <!-- ==================== 5. POR QUÉ ELEGIRNOS (Fondo Claro) ==================== -->
                <section class="home-section section-light" id="porQueElegirnos">
                  <div class="container">
                    <div class="section-header-wrap fade-up">
                      <span class="section-tag-v2" style="color: var(--color-primary);">Propuesta de Valor</span>
                      <h2 class="section-title-v2">¿Por Qué Elegir Abelardo Villa Multimarcas?</h2>
                      <p class="section-subtitle-v2">
                        Más de 40 años construyendo relaciones transparentes y duraderas con cada familia y empresa que
                        nos elige.
                      </p>
                    </div>

                    <div class="why-grid fade-up">
                      <!-- 01 -->
                      <div class="why-card">
                        <div class="why-number">01</div>
                        <div class="why-title">Trayectoria Comprobada</div>
                        <p class="why-desc">
                          Más de 40 años de trayectoria ininterrumpida en Rincón y Santa Fe, brindando seriedad y
                          respaldo familiar.
                        </p>
                      </div>

                      <!-- 02 -->
                      <div class="why-card">
                        <div class="why-number">02</div>
                        <div class="why-title">Inspección Rigurosa</div>
                        <p class="why-desc">
                          Cada unidad es seleccionada y evaluada técnica y estéticamente para garantizar que te lleves
                          un auto listo para rodar.
                        </p>
                      </div>

                      <!-- 03 -->
                      <div class="why-card">
                        <div class="why-number">03</div>
                        <div class="why-title">Tasación Justa en el Acto</div>
                        <p class="why-desc">
                          Cotizamos tu auto usado al mejor valor real de mercado, sin demoras ni descuentos
                          innecesarios.
                        </p>
                      </div>

                      <!-- 04 -->
                      <div class="why-card">
                        <div class="why-number">04</div>
                        <div class="why-title">Financiación Flexible</div>
                        <p class="why-desc">
                          Créditos prendarios en cuotas fijas en pesos, con mínimos requisitos y planes adecuados a tus
                          posibilidades.
                        </p>
                      </div>

                      <!-- 05 -->
                      <div class="why-card">
                        <div class="why-number">05</div>
                        <div class="why-title">Seguridad Jurídica Total</div>
                        <p class="why-desc">
                          Gestoría propia con verificación de dominio, libre deuda y transferencias garantizadas en el
                          Registro del Automotor.
                        </p>
                      </div>

                      <!-- 06 -->
                      <div class="why-card">
                        <div class="why-number">06</div>
                        <div class="why-title">Atención Personalizada</div>
                        <p class="why-desc">
                          Trato directo, honesto y cercano de persona a persona para que tomes la mejor decisión con
                          total tranquilidad.
                        </p>
                      </div>
                    </div>
                  </div>
                </section>

                <!-- ==================== 6. VENDÉ O PERMUTÁ TU AUTO ==================== -->
                <section class="home-section section-surface" id="vendeTuAuto">
                  <div class="container">
                    <div class="tradein-block fade-up">
                      <div class="text-center" style="max-width: 680px; margin: 0 auto;">
                        <span class="section-tag-v2">Permutas y Consignaciones</span>
                        <h2 class="section-title-v2" style="color: #fff;">Vendé o Permutá tu Vehículo</h2>
                        <p class="section-subtitle-v2" style="color: var(--neutral-300);">
                          Un proceso ágil, transparente y seguro en 3 sencillos pasos.
                        </p>
                      </div>

                      <div class="tradein-steps-grid">
                        <!-- Paso 1 -->
                        <div class="tradein-step-card">
                          <span class="tradein-step-badge">Paso 01</span>
                          <div class="tradein-step-title">Cotizá Online o Salón</div>
                          <p class="tradein-step-desc">
                            Envianos fotos y datos clave de tu vehículo (marca, modelo, año y km) por WhatsApp o
                            acercate a Ruta 1.
                          </p>
                        </div>

                        <!-- Paso 2 -->
                        <div class="tradein-step-card">
                          <span class="tradein-step-badge">Paso 02</span>
                          <div class="tradein-step-title">Peritaje Rápido</div>
                          <p class="tradein-step-desc">
                            Revisamos la documentación y el estado general de la unidad de forma transparente y sin
                            vueltas.
                          </p>
                        </div>

                        <!-- Paso 3 -->
                        <div class="tradein-step-card">
                          <span class="tradein-step-badge">Paso 03</span>
                          <div class="tradein-step-title">Llave contra Llave</div>
                          <p class="tradein-step-desc">
                            Cobrás el valor acordado al contado o dejás tu usado como parte de pago para retirarte con
                            tu nuevo vehículo.
                          </p>
                        </div>
                      </div>

                      <div class="text-center">
