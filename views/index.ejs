                <!-- ==================== SCRIPTS ESPECÍFICOS DEL HOME ==================== -->
                <script>
                  document.addEventListener('DOMContentLoaded', () => {
                    // ── 1. Tabs de Búsqueda (Usados / 0km / Todos) ──
                    const searchTabs = document.querySelectorAll('.search-tab-btn');
                    const searchCondicionInput = document.getElementById('searchCondicion');

                    searchTabs.forEach(tab => {
                      tab.addEventListener('click', () => {
                        searchTabs.forEach(t => {
                          t.classList.remove('active');
                          t.setAttribute('aria-selected', 'false');
                        });
                        tab.classList.add('active');
                        tab.setAttribute('aria-selected', 'true');
                        if (searchCondicionInput) {
                          searchCondicionInput.value = tab.dataset.condicion || '';
                        }
                      });
                    });

                    // ── 2. Modelo dependiente de la Marca (AJAX) ──
                    const marcaSelect = document.getElementById('heroMarca');
                    const modeloSelect = document.getElementById('heroModelo');

                    if (marcaSelect && modeloSelect) {
                      marcaSelect.addEventListener('change', async function () {
                        const marca = this.value.trim();
                        if (!marca) {
                          modeloSelect.innerHTML = '<option value="">Elegí una marca primero</option>';
                          modeloSelect.disabled = true;
                          return;
                        }

                        modeloSelect.disabled = true;
                        modeloSelect.innerHTML = '<option value="">Cargando modelos...</option>';

                        try {
                          const res = await fetch('/api/modelos/' + encodeURIComponent(marca));
                          if (res.ok) {
                            const modelos = await res.json();
                            modeloSelect.innerHTML = '<option value="">Todos los modelos</option>';
                            if (Array.isArray(modelos) && modelos.length > 0) {
                              modelos.forEach(m => {
                                const opt = document.createElement('option');
                                opt.value = m.modelo;
                                opt.textContent = m.modelo;
                                modeloSelect.appendChild(opt);
                              });
                              modeloSelect.disabled = false;
                            } else {
                              modeloSelect.innerHTML = '<option value="">Sin modelos específicos</option>';
                              modeloSelect.disabled = false;
                            }
                          } else {
                            modeloSelect.innerHTML = '<option value="">Todos los modelos</option>';
                            modeloSelect.disabled = false;
                          }
                        } catch (err) {
                          console.error('Error cargando modelos:', err);
                          modeloSelect.innerHTML = '<option value="">Todos los modelos</option>';
                          modeloSelect.disabled = false;
                        }
                      });
                    }

                    // ── 3. Animación de Entrada Sutil (fade + 12px) ──
                    if ('IntersectionObserver' in window) {
                      const observer = new IntersectionObserver((entries) => {
                        entries.forEach(entry => {
                          if (entry.isIntersecting) {
                            entry.target.classList.add('visible');
                            observer.unobserve(entry.target); // Se anima solo una vez
                          }
                        });
                      }, {
                        threshold: 0.12,
                        rootMargin: '0px 0px -40px 0px'
                      });

                      document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));
                    } else {
                      // Fallback para navegadores antiguos
                      document.querySelectorAll('.fade-up').forEach(el => el.classList.add('visible'));
                    }
                  });
                </script>
