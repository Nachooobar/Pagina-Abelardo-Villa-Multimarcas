</div>

<!-- ── LIGHTBOX MODAL CON FLECHAS, TECLADO Y GESTOS TÁCTILES ── -->
<div class="lightbox-modal" id="lightboxModal" role="dialog" aria-modal="true" aria-label="Visualizador de imágenes en alta resolución">
  <div class="lightbox-backdrop" onclick="closeLightbox()"></div>
  
  <div class="lightbox-container">
    <button type="button" class="lightbox-close-btn" onclick="closeLightbox()" aria-label="Cerrar imagen ampliada">✕</button>
    
    <div class="lightbox-counter" id="lightboxCounter">1 / 1</div>

    <button type="button" class="lightbox-arrow arrow-left" onclick="lightboxPrev(event)" aria-label="Foto anterior">‹</button>
    
    <div class="lightbox-image-stage" id="lightboxStage">
      <img src="" alt="Vehículo ampliado" id="lightboxActiveImg" class="lightbox-img">
    </div>

    <button type="button" class="lightbox-arrow arrow-right" onclick="lightboxNext(event)" aria-label="Foto siguiente">›</button>
  </div>
</div>

<!-- Scripts interactivos de la Ficha -->
<script>
  const galleryImages = <%- JSON.stringify(allImages) %>;
  let currentPhotoIndex = 0;

  function updateGalleryDisplay(idx) {
    if (!galleryImages || galleryImages.length === 0) return;
    if (idx < 0) idx = galleryImages.length - 1;
    if (idx >= galleryImages.length) idx = 0;
    currentPhotoIndex = idx;

    const mainImg = document.getElementById('mainImage');
    if (mainImg) mainImg.src = galleryImages[currentPhotoIndex];

    const counter = document.getElementById('photoCounter');
    if (counter) counter.textContent = `${currentPhotoIndex + 1} / ${galleryImages.length}`;

    // Actualizar thumbnails
    const thumbBtns = document.querySelectorAll('.thumb-btn');
    thumbBtns.forEach((btn, i) => {
      if (i === currentPhotoIndex) {
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      } else {
        btn.classList.remove('active');
        btn.setAttribute('aria-selected', 'false');
      }
    });
  }

  function selectImage(idx) {
    updateGalleryDisplay(idx);
  }

  function prevImage(e) {
    if (e) e.stopPropagation();
    updateGalleryDisplay(currentPhotoIndex - 1);
  }

  function nextImage(e) {
    if (e) e.stopPropagation();
    updateGalleryDisplay(currentPhotoIndex + 1);
  }

  // Lightbox
  function openLightbox(idx) {
    if (!galleryImages || galleryImages.length === 0) return;
    currentPhotoIndex = idx >= 0 ? idx : 0;
    const modal = document.getElementById('lightboxModal');
    const img = document.getElementById('lightboxActiveImg');
    const counter = document.getElementById('lightboxCounter');

    img.src = galleryImages[currentPhotoIndex];
    counter.textContent = `${currentPhotoIndex + 1} / ${galleryImages.length}`;
    modal.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    const modal = document.getElementById('lightboxModal');
    modal.classList.remove('open');
    document.body.style.overflow = '';
  }

  function lightboxPrev(e) {
    if (e) e.stopPropagation();
    currentPhotoIndex = (currentPhotoIndex - 1 + galleryImages.length) % galleryImages.length;
    document.getElementById('lightboxActiveImg').src = galleryImages[currentPhotoIndex];
    document.getElementById('lightboxCounter').textContent = `${currentPhotoIndex + 1} / ${galleryImages.length}`;
    updateGalleryDisplay(currentPhotoIndex);
  }

  function lightboxNext(e) {
    if (e) e.stopPropagation();
    currentPhotoIndex = (currentPhotoIndex + 1) % galleryImages.length;
    document.getElementById('lightboxActiveImg').src = galleryImages[currentPhotoIndex];
    document.getElementById('lightboxCounter').textContent = `${currentPhotoIndex + 1} / ${galleryImages.length}`;
    updateGalleryDisplay(currentPhotoIndex);
  }

  // Control por Teclado
  document.addEventListener('keydown', (e) => {
    const isLightboxOpen = document.getElementById('lightboxModal').classList.contains('open');
    if (isLightboxOpen) {
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') lightboxPrev();
      if (e.key === 'ArrowRight') lightboxNext();
    } else {
      if (e.key === 'ArrowLeft') prevImage();
      if (e.key === 'ArrowRight') nextImage();
    }
  });

  // Gestos táctiles Swipe en Galería Principal y Lightbox
  let touchStartX = 0;
  let touchEndX = 0;

  function handleGesture(isLightbox) {
    const swipeThreshold = 50;
    if (touchEndX < touchStartX - swipeThreshold) {
      // Swipe izquierda -> Siguiente foto
      if (isLightbox) lightboxNext();
      else nextImage();
    }
    if (touchEndX > touchStartX + swipeThreshold) {
      // Swipe derecha -> Foto anterior
      if (isLightbox) lightboxPrev();
      else prevImage();
    }
  }

  const galleryWrapper = document.getElementById('galleryMainWrapper');
  if (galleryWrapper) {
    galleryWrapper.addEventListener('touchstart', e => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });
    galleryWrapper.addEventListener('touchend', e => {
      touchEndX = e.changedTouches[0].screenX;
      handleGesture(false);
    }, { passive: true });
  }

  const lightboxStage = document.getElementById('lightboxStage');
  if (lightboxStage) {
    lightboxStage.addEventListener('touchstart', e => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });
    lightboxStage.addEventListener('touchend', e => {
      touchEndX = e.changedTouches[0].screenX;
      handleGesture(true);
    }, { passive: true });
  }

  // Formulario rápido
  function handleInquirySubmit(e) {
    e.preventDefault();
    const nombre = document.getElementById('inqNombre').value.trim();
    const telefono = document.getElementById('inqTelefono').value.trim();
    const mensaje = document.getElementById('inqMensaje').value.trim();

    const textToSend = `¡Hola! Soy ${nombre} (Tel: ${telefono}). ${mensaje} - ${window.location.href}`;
    const directWaUrl = `https://wa.me/5493425352093?text=${encodeURIComponent(textToSend)}`;
    window.open(directWaUrl, '_blank');
  }
</script>

