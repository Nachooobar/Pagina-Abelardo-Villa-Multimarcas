<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Design System — Abelardo Villa Multimarca</title>
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="icon" type="image/png" href="/images/logo.png">
  <style>
    /* ─── Page-specific styles for the showcase ─── */
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: var(--font-body);
      background: var(--surface-page);
      color: var(--text-primary);
      line-height: var(--leading-normal);
      -webkit-font-smoothing: antialiased;
    }

    .ds-page {
      max-width: 1200px;
      margin: 0 auto;
      padding: var(--space-8) var(--space-6);
    }

    .ds-page-header {
      text-align: center;
      margin-bottom: var(--space-16);
      padding: var(--space-12) 0;
      border-bottom: 2px solid var(--border-default);
    }

    .ds-page-header h1 {
      font-family: var(--font-heading);
      font-size: var(--text-4xl);
      font-weight: 800;
      color: var(--text-primary);
      letter-spacing: var(--tracking-tight);
      margin-bottom: var(--space-3);
    }

    .ds-page-header p {
      font-size: var(--text-lg);
      color: var(--text-secondary);
      max-width: 600px;
      margin: 0 auto;
    }

    .ds-page-header .ds-version {
      display: inline-block;
      margin-top: var(--space-4);
      padding: var(--space-1) var(--space-4);
      background: var(--color-info-bg);
      color: var(--color-secondary);
      border-radius: var(--radius-full);
      font-size: var(--text-xs);
      font-weight: 700;
      letter-spacing: var(--tracking-wider);
      text-transform: uppercase;
    }

    /* Sections */
    .ds-section {
      margin-bottom: var(--space-16);
    }

    .ds-section__title {
      font-family: var(--font-heading);
      font-size: var(--text-2xl);
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: var(--space-2);
      padding-bottom: var(--space-3);
      border-bottom: 2px solid var(--border-default);
      letter-spacing: var(--tracking-tight);
    }

    .ds-section__desc {
      font-size: var(--text-sm);
      color: var(--text-secondary);
      margin-bottom: var(--space-6);
      max-width: 700px;
    }

    /* Row of items */
    .ds-row {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-4);
      align-items: center;
      margin-bottom: var(--space-6);
    }

    .ds-row--start { align-items: flex-start; }

    /* Subsection label */
    .ds-subsection {
      font-size: var(--text-sm);
      font-weight: 700;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: var(--tracking-wider);
      margin-bottom: var(--space-3);
      margin-top: var(--space-6);
    }

    /* Color swatches */
    .ds-swatches {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
      gap: var(--space-3);
    }

    .ds-swatch {
      border-radius: var(--radius-md);
      overflow: hidden;
      border: 1px solid var(--border-default);
      background: var(--surface-card);
    }

    .ds-swatch__color {
      height: 64px;
    }

    .ds-swatch__info {
      padding: var(--space-2) var(--space-3);
    }

    .ds-swatch__name {
      font-size: var(--text-xs);
      font-weight: 700;
      color: var(--text-primary);
    }

    .ds-swatch__hex {
      font-size: var(--text-2xs);
      color: var(--text-tertiary);
      font-family: var(--font-mono);
    }

    /* Type specimens */
    .ds-type-specimen {
      margin-bottom: var(--space-4);
      padding: var(--space-4) var(--space-5);
      background: var(--surface-card);
      border-radius: var(--radius-md);
      border: 1px solid var(--border-default);
    }

    .ds-type-label {
      font-size: var(--text-xs);
      color: var(--text-tertiary);
      font-family: var(--font-mono);
      margin-bottom: var(--space-1);
    }

    /* Spacing scale */
    .ds-spacing-row {
      display: flex;
      align-items: center;
      gap: var(--space-4);
      margin-bottom: var(--space-2);
    }

    .ds-spacing-bar {
      background: var(--color-secondary-subtle);
      border: 1px solid var(--color-secondary);
      border-radius: var(--radius-xs);
      height: 24px;
      min-width: 4px;
    }

    .ds-spacing-label {
      font-size: var(--text-xs);
      color: var(--text-secondary);
      font-family: var(--font-mono);
      white-space: nowrap;
      min-width: 100px;
    }

    /* Form demo grid */
    .ds-form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }

    @media (max-width: 768px) {
      .ds-form-grid {
        grid-template-columns: 1fr;
      }
    }

    /* Card grid */
    .ds-card-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: var(--space-6);
    }

    @media (max-width: 480px) {
      .ds-card-grid { grid-template-columns: 1fr; }
      .ds-swatches { grid-template-columns: repeat(auto-fill, minmax(90px, 1fr)); }
    }

    /* Dark preview region */
    .ds-dark-preview {
      background: var(--neutral-900);
      border-radius: var(--radius-lg);
      padding: var(--space-8);
      margin-top: var(--space-6);
    }

    /* Contrast table */
    .ds-contrast-table {
      width: 100%;
      border-collapse: collapse;
      font-size: var(--text-sm);
    }
    .ds-contrast-table th,
    .ds-contrast-table td {
      padding: var(--space-3) var(--space-4);
      text-align: left;
      border-bottom: 1px solid var(--border-default);
    }
    .ds-contrast-table th {
      font-weight: 700;
      color: var(--text-secondary);
      font-size: var(--text-xs);
      text-transform: uppercase;
      letter-spacing: var(--tracking-wider);
      background: var(--surface-sunken);
    }
    .ds-contrast-sample {
      display: inline-block;
      padding: var(--space-1) var(--space-3);
      border-radius: var(--radius-sm);
      font-weight: 700;
      font-size: var(--text-sm);
    }
    .ds-contrast-pass {
      color: var(--color-success);
      font-weight: 700;
    }
    .ds-contrast-fail {
      color: var(--color-danger);
      font-weight: 700;
    }

    /* Environment badge */
    .ds-env-badge {
      position: fixed;
      top: var(--space-4);
      right: var(--space-4);
      background: var(--color-warning);
      color: var(--neutral-900);
      padding: var(--space-1) var(--space-4);
      border-radius: var(--radius-full);
      font-size: var(--text-xs);
      font-weight: 700;
      z-index: var(--z-toast);
      letter-spacing: var(--tracking-wider);
      text-transform: uppercase;
    }
  </style>
</head>
<body>

  <div class="ds-env-badge">Solo Desarrollo</div>

  <div class="ds-page">

    <!-- ═══════════════════ HEADER ═══════════════════ -->
    <header class="ds-page-header">
      <h1>Abelardo Villa Multimarca</h1>
      <p>Sistema de Diseño Unificado — Tokens, componentes y patrones compartidos entre la web pública y el panel de administración.</p>
      <span class="ds-version">v2.0 — Fase 2</span>
    </header>


    <!-- ═══════════════════ 1. PALETA DE COLORES ═══════════════════ -->
    <section class="ds-section" id="colors">
      <h2 class="ds-section__title">1. Paleta de Colores</h2>
      <p class="ds-section__desc">Colores de marca, neutros y estados funcionales. Cada color tiene variantes para hover, active y fondos sutiles.</p>

      <div class="ds-subsection">Marca — Primarios</div>
      <div class="ds-swatches">
        <div class="ds-swatch"><div class="ds-swatch__color" style="background:#FEF2F2"></div><div class="ds-swatch__info"><div class="ds-swatch__name">Red 50</div><div class="ds-swatch__hex">#FEF2F2</div></div></div>
        <div class="ds-swatch"><div class="ds-swatch__color" style="background:#FCA5A5"></div><div class="ds-swatch__info"><div class="ds-swatch__name">Red 300</div><div class="ds-swatch__hex">#FCA5A5</div></div></div>
        <div class="ds-swatch"><div class="ds-swatch__color" style="background:#E11D2A"></div><div class="ds-swatch__info"><div class="ds-swatch__name">Red 500 ★</div><div class="ds-swatch__hex">#E11D2A</div></div></div>
        <div class="ds-swatch"><div class="ds-swatch__color" style="background:#C5131F"></div><div class="ds-swatch__info"><div class="ds-swatch__name">Red 600</div><div class="ds-swatch__hex">#C5131F</div></div></div>
        <div class="ds-swatch"><div class="ds-swatch__color" style="background:#A80E18"></div><div class="ds-swatch__info"><div class="ds-swatch__name">Red 700</div><div class="ds-swatch__hex">#A80E18</div></div></div>
        <div class="ds-swatch"><div class="ds-swatch__color" style="background:#5C0A0F; color:#fff"></div><div class="ds-swatch__info"><div class="ds-swatch__name">Red 900</div><div class="ds-swatch__hex">#5C0A0F</div></div></div>
      </div>

      <div class="ds-subsection">Marca — Secundarios</div>
      <div class="ds-swatches">
        <div class="ds-swatch"><div class="ds-swatch__color" style="background:#EFF6FF"></div><div class="ds-swatch__info"><div class="ds-swatch__name">Blue 50</div><div class="ds-swatch__hex">#EFF6FF</div></div></div>
        <div class="ds-swatch"><div class="ds-swatch__color" style="background:#93C5FD"></div><div class="ds-swatch__info"><div class="ds-swatch__name">Blue 300</div><div class="ds-swatch__hex">#93C5FD</div></div></div>
        <div class="ds-swatch"><div class="ds-swatch__color" style="background:#1479BE; color:#fff"></div><div class="ds-swatch__info"><div class="ds-swatch__name">Blue 500 ★</div><div class="ds-swatch__hex">#1479BE</div></div></div>
        <div class="ds-swatch"><div class="ds-swatch__color" style="background:#0E629D; color:#fff"></div><div class="ds-swatch__info"><div class="ds-swatch__name">Blue 600</div><div class="ds-swatch__hex">#0E629D</div></div></div>
        <div class="ds-swatch"><div class="ds-swatch__color" style="background:#062E4C; color:#fff"></div><div class="ds-swatch__info"><div class="ds-swatch__name">Blue 900</div><div class="ds-swatch__hex">#062E4C</div></div></div>
      </div>

      <div class="ds-subsection">Neutros</div>
      <div class="ds-swatches">
        <div class="ds-swatch"><div class="ds-swatch__color" style="background:#FFFFFF; border:1px solid #E3E7EC"></div><div class="ds-swatch__info"><div class="ds-swatch__name">White</div><div class="ds-swatch__hex">#FFFFFF</div></div></div>
        <div class="ds-swatch"><div class="ds-swatch__color" style="background:#F6F7F9"></div><div class="ds-swatch__info"><div class="ds-swatch__name">Neutral 50</div><div class="ds-swatch__hex">#F6F7F9</div></div></div>
        <div class="ds-swatch"><div class="ds-swatch__color" style="background:#E3E7EC"></div><div class="ds-swatch__info"><div class="ds-swatch__name">Neutral 200</div><div class="ds-swatch__hex">#E3E7EC</div></div></div>
        <div class="ds-swatch"><div class="ds-swatch__color" style="background:#94A3B8"></div><div class="ds-swatch__info"><div class="ds-swatch__name">Neutral 400</div><div class="ds-swatch__hex">#94A3B8</div></div></div>
        <div class="ds-swatch"><div class="ds-swatch__color" style="background:#64748B; color:#fff"></div><div class="ds-swatch__info"><div class="ds-swatch__name">Neutral 500</div><div class="ds-swatch__hex">#64748B</div></div></div>
        <div class="ds-swatch"><div class="ds-swatch__color" style="background:#1E293B; color:#fff"></div><div class="ds-swatch__info"><div class="ds-swatch__name">Neutral 800</div><div class="ds-swatch__hex">#1E293B</div></div></div>
        <div class="ds-swatch"><div class="ds-swatch__color" style="background:#151A21; color:#fff"></div><div class="ds-swatch__info"><div class="ds-swatch__name">Neutral 850</div><div class="ds-swatch__hex">#151A21</div></div></div>
        <div class="ds-swatch"><div class="ds-swatch__color" style="background:#0E1116; color:#fff"></div><div class="ds-swatch__info"><div class="ds-swatch__name">Neutral 900</div><div class="ds-swatch__hex">#0E1116</div></div></div>
      </div>

      <div class="ds-subsection">Estados Funcionales</div>
      <div class="ds-swatches">
        <div class="ds-swatch"><div class="ds-swatch__color" style="background:#10B981; color:#fff"></div><div class="ds-swatch__info"><div class="ds-swatch__name">Success</div><div class="ds-swatch__hex">#10B981</div></div></div>
        <div class="ds-swatch"><div class="ds-swatch__color" style="background:#F59E0B"></div><div class="ds-swatch__info"><div class="ds-swatch__name">Warning</div><div class="ds-swatch__hex">#F59E0B</div></div></div>
        <div class="ds-swatch"><div class="ds-swatch__color" style="background:#EF4444; color:#fff"></div><div class="ds-swatch__info"><div class="ds-swatch__name">Danger</div><div class="ds-swatch__hex">#EF4444</div></div></div>
        <div class="ds-swatch"><div class="ds-swatch__color" style="background:#1479BE; color:#fff"></div><div class="ds-swatch__info"><div class="ds-swatch__name">Info</div><div class="ds-swatch__hex">#1479BE</div></div></div>
      </div>

      <div class="ds-subsection">Bordó (Footer)</div>
      <div class="ds-swatches">
        <div class="ds-swatch"><div class="ds-swatch__color" style="background:#4D1016; color:#fff"></div><div class="ds-swatch__info"><div class="ds-swatch__name">Bordó Light</div><div class="ds-swatch__hex">#4D1016</div></div></div>
        <div class="ds-swatch"><div class="ds-swatch__color" style="background:#360B10; color:#fff"></div><div class="ds-swatch__info"><div class="ds-swatch__name">Bordó 500 ★</div><div class="ds-swatch__hex">#360B10</div></div></div>
        <div class="ds-swatch"><div class="ds-swatch__color" style="background:#1A0406; color:#fff"></div><div class="ds-swatch__info"><div class="ds-swatch__name">Bordó Dark</div><div class="ds-swatch__hex">#1A0406</div></div></div>
      </div>
    </section>


    <!-- ═══════════════════ 2. TIPOGRAFÍA ═══════════════════ -->
    <section class="ds-section" id="typography">
      <h2 class="ds-section__title">2. Tipografía</h2>
      <p class="ds-section__desc">Títulos en <strong>Sora</strong> (600–800), cuerpo en <strong>Inter</strong> (400–600). Escala tipográfica Major Third (1.250).</p>

      <div class="ds-type-specimen">
        <div class="ds-type-label">--text-6xl · 60px · Sora 800</div>
        <div style="font-family:var(--font-heading);font-size:var(--text-6xl);font-weight:800;letter-spacing:var(--tracking-tighter);line-height:var(--leading-tight)">Multimarca</div>
      </div>

      <div class="ds-type-specimen">
        <div class="ds-type-label">--text-5xl · 48px · Sora 800</div>
        <div style="font-family:var(--font-heading);font-size:var(--text-5xl);font-weight:800;letter-spacing:var(--tracking-tighter);line-height:var(--leading-tight)">Tu próximo auto</div>
      </div>

      <div class="ds-type-specimen">
        <div class="ds-type-label">--text-4xl · 36px · Sora 700</div>
        <div style="font-family:var(--font-heading);font-size:var(--text-4xl);font-weight:700;letter-spacing:var(--tracking-tight);line-height:var(--leading-tight)">Catálogo Completo</div>
      </div>

      <div class="ds-type-specimen">
        <div class="ds-type-label">--text-3xl · 30px · Sora 700</div>
        <div style="font-family:var(--font-heading);font-size:var(--text-3xl);font-weight:700;letter-spacing:var(--tracking-tight);line-height:var(--leading-snug)">Vehículos Destacados</div>
      </div>

      <div class="ds-type-specimen">
        <div class="ds-type-label">--text-2xl · 24px · Sora 700</div>
        <div style="font-family:var(--font-heading);font-size:var(--text-2xl);font-weight:700;letter-spacing:var(--tracking-tight);line-height:var(--leading-snug)">Sección del panel admin</div>
      </div>

      <div class="ds-type-specimen">
        <div class="ds-type-label">--text-xl · 20px · Sora 600</div>
        <div style="font-family:var(--font-heading);font-size:var(--text-xl);font-weight:600;line-height:var(--leading-snug)">Nombre del Vehículo</div>
      </div>

      <div class="ds-type-specimen">
        <div class="ds-type-label">--text-base · 16px · Inter 400</div>
        <div style="font-family:var(--font-body);font-size:var(--text-base);font-weight:400;line-height:var(--leading-relaxed)">Más de 40 años de trayectoria nos avalan. En Abelardo Villa Multimarca encontrá el auto que buscás con garantía, financiación y la confianza de siempre.</div>
      </div>

      <div class="ds-type-specimen">
        <div class="ds-type-label">--text-sm · 14px · Inter 500</div>
        <div style="font-family:var(--font-body);font-size:var(--text-sm);font-weight:500;line-height:var(--leading-normal)">Texto de interfaz, etiquetas de formularios, textos de ayuda y especificaciones técnicas del vehículo.</div>
      </div>

      <div class="ds-type-specimen">
        <div class="ds-type-label">--text-xs · 12px · Inter 600</div>
        <div style="font-family:var(--font-body);font-size:var(--text-xs);font-weight:600;line-height:var(--leading-normal);letter-spacing:var(--tracking-wider);text-transform:uppercase">Etiqueta · Badge · Marca del auto</div>
      </div>
    </section>


    <!-- ═══════════════════ 3. SPACING ═══════════════════ -->
    <section class="ds-section" id="spacing">
      <h2 class="ds-section__title">3. Escala de Espaciado (Base 8px)</h2>
      <p class="ds-section__desc">Escala progresiva basada en múltiplos de 8px para consistencia perfecta en paddings, margins y gaps.</p>

      <div class="ds-spacing-row"><span class="ds-spacing-label">--space-1 (4px)</span><div class="ds-spacing-bar" style="width:4px"></div></div>
      <div class="ds-spacing-row"><span class="ds-spacing-label">--space-2 (8px)</span><div class="ds-spacing-bar" style="width:8px"></div></div>
      <div class="ds-spacing-row"><span class="ds-spacing-label">--space-3 (12px)</span><div class="ds-spacing-bar" style="width:12px"></div></div>
      <div class="ds-spacing-row"><span class="ds-spacing-label">--space-4 (16px)</span><div class="ds-spacing-bar" style="width:16px"></div></div>
      <div class="ds-spacing-row"><span class="ds-spacing-label">--space-6 (24px)</span><div class="ds-spacing-bar" style="width:24px"></div></div>
      <div class="ds-spacing-row"><span class="ds-spacing-label">--space-8 (32px)</span><div class="ds-spacing-bar" style="width:32px"></div></div>
      <div class="ds-spacing-row"><span class="ds-spacing-label">--space-10 (40px)</span><div class="ds-spacing-bar" style="width:40px"></div></div>
      <div class="ds-spacing-row"><span class="ds-spacing-label">--space-12 (48px)</span><div class="ds-spacing-bar" style="width:48px"></div></div>
      <div class="ds-spacing-row"><span class="ds-spacing-label">--space-16 (64px)</span><div class="ds-spacing-bar" style="width:64px"></div></div>
      <div class="ds-spacing-row"><span class="ds-spacing-label">--space-20 (80px)</span><div class="ds-spacing-bar" style="width:80px"></div></div>
      <div class="ds-spacing-row"><span class="ds-spacing-label">--space-24 (96px)</span><div class="ds-spacing-bar" style="width:96px"></div></div>
      <div class="ds-spacing-row"><span class="ds-spacing-label">--space-32 (128px)</span><div class="ds-spacing-bar" style="width:128px"></div></div>
    </section>


    <!-- ═══════════════════ 4. BUTTONS ═══════════════════ -->
    <section class="ds-section" id="buttons">
      <h2 class="ds-section__title">4. Botones</h2>
      <p class="ds-section__desc">Variantes: Primary (rojo), Secondary (azul), Outline, Ghost, Danger. Cada uno con estados hover, active, disabled y loading.</p>

      <div class="ds-subsection">Variantes (tamaño md)</div>
      <div class="ds-row">
        <button class="ds-btn ds-btn--primary">Primary</button>
        <button class="ds-btn ds-btn--secondary">Secondary</button>
        <button class="ds-btn ds-btn--outline">Outline</button>
        <button class="ds-btn ds-btn--ghost">Ghost</button>
        <button class="ds-btn ds-btn--danger">Danger</button>
      </div>

      <div class="ds-subsection">Tamaños</div>
      <div class="ds-row">
        <button class="ds-btn ds-btn--secondary ds-btn--sm">Small</button>
        <button class="ds-btn ds-btn--secondary">Medium</button>
        <button class="ds-btn ds-btn--secondary ds-btn--lg">Large</button>
      </div>

      <div class="ds-subsection">Con ícono</div>
      <div class="ds-row">
        <button class="ds-btn ds-btn--primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
          Agregar Auto
        </button>
        <button class="ds-btn ds-btn--outline">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Descargar
        </button>
        <button class="ds-btn ds-btn--secondary ds-btn--icon-only" aria-label="Editar">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        </button>
      </div>

      <div class="ds-subsection">Loading y Disabled</div>
      <div class="ds-row">
        <button class="ds-btn ds-btn--primary ds-btn--loading">Loading</button>
        <button class="ds-btn ds-btn--secondary ds-btn--loading">Loading</button>
        <button class="ds-btn ds-btn--outline ds-btn--loading">Loading</button>
