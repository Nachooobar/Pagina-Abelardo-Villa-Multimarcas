      <p class="ds-section__desc">Ratio mínimo requerido: 4.5:1 (texto normal) y 3:1 (texto grande ≥ 18px bold). Todas las combinaciones cumplen con WCAG AA.</p>

      <table class="ds-contrast-table">
        <thead>
          <tr>
            <th>Combinación</th>
            <th>Vista Previa</th>
            <th>Ratio</th>
            <th>AA Normal</th>
            <th>AA Grande</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>#0E1116 sobre #F6F7F9</td>
            <td><span class="ds-contrast-sample" style="background:#F6F7F9;color:#0E1116">Texto</span></td>
            <td>16.8:1</td>
            <td><span class="ds-contrast-pass">✓ Pasa</span></td>
            <td><span class="ds-contrast-pass">✓ Pasa</span></td>
          </tr>
          <tr>
            <td>#FFFFFF sobre #E11D2A</td>
            <td><span class="ds-contrast-sample" style="background:#E11D2A;color:#FFFFFF">Botón</span></td>
