  <!-- ═══════════════════ Scripts ═══════════════════ -->
  <script>
    // Tab switching
    function switchTab(event, panelId) {
      // Deactivate all tabs
      document.querySelectorAll('.ds-tabs__tab').forEach(tab => tab.classList.remove('is-active'));
      // Hide all panels
      document.querySelectorAll('.ds-tabs__panel').forEach(panel => panel.hidden = true);
      // Activate clicked tab
      event.currentTarget.classList.add('is-active');
      // Show corresponding panel
      document.getElementById(panelId).hidden = false;
    }
  </script>

